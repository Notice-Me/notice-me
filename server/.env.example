# Run commands from server/. Copy this file to .env, never commit .env.
NOTICE_DB_PATH=data/notice_me.db
# mock: offline only / live: stored real content only / mixed: explicit live+fixtures
NOTICE_DATA_MODE=mock
NOTICE_HTTP_TIMEOUT_SECONDS=10
# News GET only: read timeout; connect/write/pool=5s, each attempt total deadline=30s.
NOTICE_NEWS_READ_TIMEOUT_SECONDS=20
# At most one retry for timeout/network/502/503/504; no retry for 500/auth/429.
NOTICE_NEWS_MAX_RETRIES=1
# News attempt budget per CLI invocation, including retries and details.
NOTICE_NEWS_REQUEST_BUDGET=20
NOTICE_FREENEWS_API_KEY=
NOTICE_THENEWSAPI_TOKEN=
NOTICE_GNEWS_API_KEY=
# Seoul sample is public, limited to first 5 rows; no personal account required.
NOTICE_SEOUL_API_KEY=sample
NOTICE_TOUR_API_KEY=
NOTICE_ITS_API_KEY=
# Only when an organizer-confirmed file has been prepared; no remote crawling.
NOTICE_MANUAL_EVENTS_PATH=
# School LLM endpoint and driving-time provider intentionally not invented.
